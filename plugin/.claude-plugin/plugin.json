{
  "name": "tkr",
  "version": "5.28.0",
  "description": "Token Reducer \u2014 unified token efficiency plugin for Claude Code. Tool output compression, semantic search, capacity-aware delegation, and output brevity.",
  "author": {
    "name": "Brantley Peers"
  },
  "license": "MIT",
  "keywords": [
    "token-reduction",
    "compression",
    "search",
    "delegation",
    "efficiency"
  ],
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook pre-compact",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__delegate(_resume)?$",
        "hooks": [{"type": "command", "command": "tkr hook delegate-host", "timeout": 5}]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 5 tkr hook rewrite",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook agent-search-inject"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 5 tkr hook long-runner-warn",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 5 tkr hook cache-bust-warn",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook skill-invoked"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 5 tkr hook praxis-checkpoint",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook session-start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook post-tool-call"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 5 tkr hook cli-corrections",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook post-tool-batch",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook subagent-outcome",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook memory-health",
            "asyncRewake": true,
            "timeout": 30
          },
          {
            "type": "command",
            "command": "tkr hook session-summary",
            "asyncRewake": true,
            "timeout": 30
          },
          {
            "type": "command",
            "command": "tkr keepalive watch",
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/keepalive/cleanup.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "tkr hook team-push",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "tkr hook session-summary",
            "timeout": 20
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "tkr hook instructions-loaded"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "tkr": {
      "command": "tkr",
      "args": [
        "mcp"
      ]
    }
  }
}
